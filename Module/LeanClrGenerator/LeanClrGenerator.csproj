<Project Sdk="Microsoft.NET.Sdk">

  <!-- LeanCLR 插件代理生成器：只通过 BuildScript\leanclr\LeanClrPlugin.targets 挂到游戏插件，不进入 CompilingGenerator.projitems -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <AssemblyName>Titan.LeanClrGenerator</AssemblyName>
    <RootNamespace>EngineNS.LeanCLR.Generator</RootNamespace>
    <Nullable>enable</Nullable>
    <EnforceExtendedAnalyzerRules>true</EnforceExtendedAnalyzerRules>
    <IsRoslynComponent>true</IsRoslynComponent>
    <LangVersion>latest</LangVersion>
    <!-- 诊断只在仓库内使用，不做 analyzer release tracking -->
    <NoWarn>$(NoWarn);RS2008</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" PrivateAssets="all" />
  </ItemGroup>

</Project>

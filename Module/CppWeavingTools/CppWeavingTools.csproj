<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(_TitanTargetFramework)</TargetFramework>
  </PropertyGroup>

  <!-- 同 CSharpCodeTools：构建输出跟着仓库根的 BaseOutputPath 落在 intermediate\csharp 下，部署到 binaries/Tools
       由 -p:TitanToolDeployDir 显式触发，避免解决方案“重新生成”覆盖正在运行的生成工具实例。 -->
  <PropertyGroup>
    <OutputPath Condition="'$(TitanToolDeployDir)' != ''">$([MSBuild]::NormalizeDirectory('$(TitanToolDeployDir)'))</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ClangSharp" />
  </ItemGroup>

  <!-- 工程求值（vcxproj/vcxitems → 头文件/include/宏）只走 Module/TitanProjectEval，
       与 CMake 源清单同一份实现，不再自带第二套 XML 读取。 -->
  <ItemGroup>
    <ProjectReference Include="..\TitanProjectEval\TitanProjectEval.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Titan.Tests.CppWeaving" />
    <Content Include="../../codegen/Templates/*" Link="Templates/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ClangSharp 的 native 依赖靠 runtime.json 选包，无 RID 构建不会带出；按宿主显式引用（Mac 仅支持 Apple Silicon） -->
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <PackageReference Include="libclang.runtime.win-x64" />
    <PackageReference Include="libClangSharp.runtime.win-x64" />
  </ItemGroup>
  <ItemGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <PackageReference Include="libclang.runtime.osx-arm64" />
    <PackageReference Include="libClangSharp.runtime.osx-arm64" />
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <!-- TitanPlatform 未指定时按主机系统选择（Windows | Mac），并给出对应的引擎工程与平台宏 -->
  <Import Project="..\..\BuildScript\msbuild\TitanManagedProject.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <PublishAot>False</PublishAot>
    <ApplicationIcon>Resources\TitanEditor.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="$(TitanEngineProject)" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Resources\TitanEditor.ico" />
    <None Remove="Resources\TitanEditor.png" />
    <Content Include="Resources\TitanEditor.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Resources\TitanEditor.png" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <OutputPath>..\..\binaries\</OutputPath>
    <!--arm64 mac 载入 AMD64 标记的入口程序集会 FileLoadException(0x80131621)，x64 仅 Windows-->
    <PlatformTarget Condition="'$(TitanPlatform)' != 'Mac'">x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>full</DebugType>
    <Optimize>False</Optimize>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <OutputPath>..\..\binaries\</OutputPath>
    <PlatformTarget Condition="'$(TitanPlatform)' != 'Mac'">x64</PlatformTarget>
    <DefineConstants>$(DefineConstants);TRACE</DefineConstants>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DebugType>full</DebugType>
    <Optimize>True</Optimize>
  </PropertyGroup>

  <ProjectExtensions><VisualStudio><UserProperties /></VisualStudio></ProjectExtensions>

</Project>

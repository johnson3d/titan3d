<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>$(_TitanTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <NoWarn>$(NoWarn);1701;1702;1998</NoWarn>
  </PropertyGroup>

  <!-- 工程自身的构建输出跟着仓库根的 BaseOutputPath 落在 intermediate\csharp 下，不直接落到 binaries/Tools：
       代码生成流程会把这个工具部署到 binaries/Tools 后运行，工具进程会锁住该目录下的 dll，
       若构建输出就是部署目录，解决方案“重新生成”就会因为覆盖正在运行的实例而失败（MSB3026/MSB3027）。
       部署统一由 -p:TitanToolDeployDir=<root>\binaries\Tools 触发。 -->
  <PropertyGroup>
    <OutputPath Condition="'$(TitanToolDeployDir)' != ''">$([MSBuild]::NormalizeDirectory('$(TitanToolDeployDir)'))</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.CodeAnalysis.Analyzers">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.CodeAnalysis.Common" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />

  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Titan.Tests.CSharpCodeTools" />
    <Content Include="../../codegen/Templates/*" Link="Templates/%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>

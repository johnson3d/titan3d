{
  "mcpServers": {
    "titan-engine-mcp": {
      "command": "python",
      "args": [
        "${workspaceFolder}/Plugins/AIGC/MCPServer/Python/titan_mcp_server.py",
        "--port",
        "18118"
      ]
    },
    "renderdoc": {
      "command": "python",
      "args": [
        "-m",
        "renderdoc_mcp"
      ],
      "env": {
        "RENDERDOC_MODULE_PATH": "${workspaceFolder}/3rd/native/renderdoc/Development"
      }
    }
  }
}

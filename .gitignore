# ==============================================================================
# 根目录白名单：顶层默认全忽略，只豁免有意入库的条目。
# 任何新冒出的顶层目录/文件（构建缓存、临时脚本、工具产物）都不会再污染
# git status；确实需要入库的新顶层目录必须在此显式加 "!/<name>/" 豁免。
# ==============================================================================
/*
!/.aone_copilot/
!/.github/
!/.qoder/
!/.vscode/
!/.gitattributes
!/.gitignore
!/.mcp.json
!/3rd/
!/BuildScript/
!/CSharpCode/
!/Core.Android/
!/Core.iOS/
!/Core.Mac/
!/Core.Window/
!/Documents/
!/Module/
!/NativeCode/
!/Plugins/
!/Tests/
!/binaries/
!/codegen/
!/content/
!/enginecontent/
!/BuildEngine.bat
!/BuildGame.bat
!/CS_Rpc_AutoSync.bat
!/CS_Rpc_Engine.bat
!/Directory.Build.props
!/Directory.Packages.props
!/EngineAll.sln
!/GenGlueCode.bat
!/LICENSE.md
!/README.md
!/README-Eng.md
!/Rpc_Engine.txt
!/Setup.bat
!/setup.sh
!/global.json
!/mapper.txt
!/pre-commit.hook

# ==============================================================================
# Binaries 白名单（拒绝式）：默认全部忽略。
# 已跟踪的 vendored 运行库（binaries/debug、release、Tools/net[5-8].0 下的
# libclang/PhysX/SDL 等 77 个文件）不受 ignore 影响，仍在版本控制内。
# 将来新增 vendored 运行库时，必须在此显式加一行 "!/binaries/<路径>" 豁免。
# ==============================================================================
/binaries/*

# ==============================================================================
# .NET 工程通用构建输出（覆盖所有 Module / Plugins 下的工程）
# ==============================================================================
**/bin/
**/obj/
# 豁免 3rd 下有意提交的预编译依赖目录
!3rd/**/bin/
!3rd/**/obj/

# ==============================================================================
# Visual Studio / IDE
# ==============================================================================
.vs/
*.suo
*.db
*.opendb
*.ipch
*.sdf
*.ncb
*.aps
*.user

# MSVC 构建日志 / 中间文件
*.tlog
*.lastbuildstate
*.iobj
*.ipdb

# ==============================================================================
# NuGet 本地生成物（还原过程自动写出，与构建环境相关，不入库）
# ==============================================================================
# 仓库级默认源配置，由 dotnet/nuget restore 生成
/.nuget/
# packages.config 工程的迁移标记目录
**/NuGet/Migrations/

# ==============================================================================
# 产物 / 缓存 / 生成代码
# binaries 产物目录已由上方 /binaries/* 白名单统一挡住；
# 此处仅保留 binaries 之外的规则。
# ==============================================================================
# LeanCLR VM 程序集由构建部署（BuildScript/LeanClrDeploy.targets），只有 BCL 入库
/content/LeanCLR/*
!/content/LeanCLR/mscorlib.dll
!/content/LeanCLR/System.dll
!/content/LeanCLR/System.Core.dll
!/content/LeanCLR/netstandard.dll
imgui.ini

# ==============================================================================
# PDB 符号文件
# ==============================================================================
*.pdb

# ==============================================================================
# C++ 构建中间产物
# ==============================================================================
/Core.Window/x64
/Core.Window/binaries/
/Core.iOS/ARM64
intermediate

# ==============================================================================
# Artifacts / Cache / Packages / CodeGen
# ==============================================================================
/artifacts/
/cache
/docs/
packages
/codegen/**/*.h
/codegen/**/*.cpp
/codegen/**/*.cs
/codegen/**/*.stamp
# 三个平台的源码、反射输出与生成清单均不入库；共用 Templates 入库。
/codegen/Windows/
/codegen/Mac/
/codegen/Android/
# 旧无平台前缀的生成目录已退出版本控制，本地残留不再入库。
/codegen/NativeBinder/
/codegen/Rpc/
/codegen/Property/
/codegen/Macross/
/codegen/Serializer/

# ==============================================================================
# Plugins 构建输出
# ==============================================================================
Plugins/**/binaries/

# ==============================================================================
# 第三方库构建中间产物
# ==============================================================================
/3rd/native/LeanCLR/lib/
3rd/native/crunch/lib/
3rd/native/lp_solve/lpsolve55/x64/Release/

# ==============================================================================
# Copilot / IDE 临时文件
# ==============================================================================
.aone_copilot/mcp_state.json
# Qoder 本地生成的仓库 wiki 缓存 (.qoder/skills/ 是手写规范, 仍需入库)
.qoder/repowiki/

# ==============================================================================
# 代码生成临时项目文件
# ==============================================================================
content/MacrossGenCSharp.projitems
content/MacrossGenCSharp.shproj

# ==============================================================================
# OS 通用
# ==============================================================================
Thumbs.db
Desktop.ini
.DS_Store

# ==============================================================================
# 其他
# ==============================================================================
content/Sheng
/3rd/native/renderdoc/Development

# Test results
TestResults/
/content/UTest/sequencer_t0.xnd

# macOS 原生构建目录
/Core.Mac/build*/

# Local .NET SDK installed by Core.Mac/ensure_dotnet.sh (never commit it)
/3rd/tools/dotnet-sdk/

# llvm-project sources + build tree cloned/built by Core.Mac/setup.sh for static libc++.a
/3rd/native/llvm-project/
/3rd/native/llvm-project.clone/

# Qoder 会话临时文件（提交消息模板、批量改写脚本等）
/session-state/

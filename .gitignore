# ==============================================================================
# .NET 工程通用构建输出（覆盖所有 Module / Plugins 下的工程）
# ==============================================================================
**/bin/
**/obj/
# 豁免 3rd 下有意提交的预编译依赖目录
!3rd/**/bin/
!3rd/**/obj/

# ==============================================================================
# Visual Studio / IDE
# ==============================================================================
.vs/
*.suo
*.db
*.opendb
*.ipch
*.sdf
*.ncb
*.aps
*.user

# MSVC 构建日志 / 中间文件
*.tlog
*.lastbuildstate
*.iobj
*.ipdb

# ==============================================================================
# NuGet 本地生成物（还原过程自动写出，与构建环境相关，不入库）
# ==============================================================================
# 仓库级默认源配置，由 dotnet/nuget restore 生成
/.nuget/
# packages.config 工程的迁移标记目录
**/NuGet/Migrations/

# ==============================================================================
# Binaries 构建输出
# ==============================================================================
/binaries/debug/
/binaries/release/
/binaries/temp/
/binaries/net5.0
/binaries/net7.0
/binaries/net8.0
/binaries/Tools/
/binaries/Plugins
/binaries/BrickManager/
/binaries/Tracer/
/binaries/AloneGame/
/binaries/LocalizationTool/
/binaries/cache/
/binaries/aftermath-shaders/
/binaries/LeanClrStub/
# Android 原生库产物由 CMake 直接写入（与 Core.Window 的 binaries/debug|release 并列）
/binaries/android/
# LeanCLR VM 程序集由构建部署（BuildScript/LeanClrDeploy.targets），只有 BCL 入库
/content/LeanCLR/*
!/content/LeanCLR/mscorlib.dll
!/content/LeanCLR/System.dll
!/content/LeanCLR/System.Core.dll
!/content/LeanCLR/netstandard.dll
/binaries/Core.Window.lib
/binaries/Core.Window.dll
/binaries/Core.Window.exp
imgui.ini

# ==============================================================================
# PDB 符号文件
# ==============================================================================
*.pdb

# ==============================================================================
# C++ 构建中间产物
# ==============================================================================
/Core.Window/x64
/Core.Window/binaries/
/Core.iOS/ARM64
intermediate

# ==============================================================================
# Artifacts / Cache / Packages / CodeGen
# ==============================================================================
/artifacts/
/cache
/docs/
packages
/codegen/**/*.h
/codegen/**/*.cpp
/codegen/**/*.cs
/codegen/**/*.stamp
# 三个平台的源码、反射输出与生成清单均不入库；共用 Templates 入库。
/codegen/Windows/
/codegen/Mac/
/codegen/Android/
# 旧无平台前缀的生成目录已退出版本控制，本地残留不再入库。
/codegen/NativeBinder/
/codegen/Rpc/
/codegen/Property/
/codegen/Macross/
/codegen/Serializer/

# ==============================================================================
# Plugins 构建输出
# ==============================================================================
Plugins/**/binaries/

# ==============================================================================
# 第三方库构建中间产物
# ==============================================================================
/3rd/native/LeanCLR/lib/
3rd/native/crunch/lib/
3rd/native/lp_solve/lpsolve55/x64/Release/

# ==============================================================================
# Copilot / IDE 临时文件
# ==============================================================================
.aone_copilot/mcp_state.json
# Qoder 本地生成的仓库 wiki 缓存 (.qoder/skills/ 是手写规范, 仍需入库)
.qoder/repowiki/

# ==============================================================================
# 代码生成临时项目文件
# ==============================================================================
content/MacrossGenCSharp.projitems
content/MacrossGenCSharp.shproj

# ==============================================================================
# OS 通用
# ==============================================================================
Thumbs.db
Desktop.ini
.DS_Store

# ==============================================================================
# 其他
# ==============================================================================
content/Sheng
/3rd/native/renderdoc/Development

# Test results
/TestResults/
/content/UTest/sequencer_t0.xnd

# macOS 原生构建目录
/Core.Mac/build*/

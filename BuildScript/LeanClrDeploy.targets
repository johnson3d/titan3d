<Project>
  <!--
    把 VM 程序集（EngineStub、插件桩、热更脚本）部署到 content\LeanCLR\$(LeanClrContentSubDir)，
    引擎启动时 TtLeanClrAssemblyScanner 递归扫描该目录自动注册，打包也只需带上 content\LeanCLR。
    只拷 IntermediateAssembly 与同名 pdb：输出目录可能混入依赖 dll，且 Plugins 的 PostBuild 会把 pdb 改名成 tpdb。
    测试用桩设 LeanClrDeployToContent=false，避免进入正式扫描目录。
  -->
  <PropertyGroup>
    <LeanClrDeployToContent Condition="'$(LeanClrDeployToContent)' == ''">true</LeanClrDeployToContent>
    <LeanClrContentDir>$([MSBuild]::EnsureTrailingSlash($([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\content\LeanCLR\$(LeanClrContentSubDir)'))))</LeanClrContentDir>
  </PropertyGroup>

  <!-- 早于 PostBuildEvent：Plugins 的 PostBuild 会删除 obj 下的 pdb -->
  <Target Name="LeanClrDeployToContent"
          AfterTargets="CopyFilesToOutputDirectory"
          Condition="'$(LeanClrDeployToContent)' == 'true'">
    <ItemGroup>
      <LeanClrDeployFile Include="@(IntermediateAssembly->'%(FullPath)')" />
      <LeanClrDeployFile Include="@(IntermediateAssembly->'%(RootDir)%(Directory)%(Filename).pdb')"
                         Condition="Exists('%(IntermediateAssembly.RootDir)%(IntermediateAssembly.Directory)%(IntermediateAssembly.Filename).pdb')" />
    </ItemGroup>
    <Copy SourceFiles="@(LeanClrDeployFile)"
          DestinationFolder="$(LeanClrContentDir)"
          SkipUnchangedFiles="true" />
    <Message Importance="high" Text="LeanCLR: $(TargetName) -> $(LeanClrContentDir)" />
  </Target>
</Project>

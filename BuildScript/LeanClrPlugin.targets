<Project>
  <!--
    游戏插件导入本文件以启用 LeanCLR 代理生成：
    [EngineNS.LeanCLR.TtLeanClr] 类中 [Rtti.Meta]（无 NoMacrossUseable）的方法生成 intrinsic 代理与注册表，
    同时把 VM 桩源码 TtLeanClrStubs.g.cs 输出到 obj\LeanClrGenerated，供 LeanClrStub.targets 收集。
  -->
  <PropertyGroup>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <CompilerGeneratedFilesOutputPath>$(MSBuildProjectDirectory)\obj\LeanClrGenerated</CompilerGeneratedFilesOutputPath>
  </PropertyGroup>

  <ItemGroup>
    <!-- 落盘副本只供桩工程收集；插件可能把 obj 移出默认路径（Plugins\Directory.Build.props），需显式排除以免重复编译 -->
    <Compile Remove="$(CompilerGeneratedFilesOutputPath)\**" />
    <ProjectReference Include="$(MSBuildThisFileDirectory)..\Module\LeanClrGenerator\LeanClrGenerator.csproj"
                      OutputItemType="Analyzer"
                      ReferenceOutputAssembly="false" />
  </ItemGroup>
</Project>

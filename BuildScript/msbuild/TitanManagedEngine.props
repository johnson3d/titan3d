<Project>
  <Import Project="$(MSBuildThisFileDirectory)TitanPlatform.props" />
  <PropertyGroup>
    <TitanManagedRoot>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..'))</TitanManagedRoot>
    <TtTitanRoot Condition="'$(TitanRoot)' == ''">$(TitanManagedRoot)</TtTitanRoot>
    <TtTitanRoot Condition="'$(TitanRoot)' != ''">$([MSBuild]::NormalizeDirectory('$(TitanRoot)'))</TtTitanRoot>
    <TargetFramework>net8.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <OutputPath>$(TitanManagedRoot)binaries/</OutputPath>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DefineConstants>$(DefineConstants);$(TitanPlatformDefine);$(TitanNativeCapabilityDefines);TRACE;TitanEngine_AutoGen_RPC;TitanEngine_AutoGen_Macross</DefineConstants>
    <NoWarn>1701;1702;1998;8632</NoWarn>
    <DebugType>full</DebugType>
    <Optimize Condition="'$(Configuration)' == 'Debug'">False</Optimize>
    <Optimize Condition="'$(Configuration)' == 'Release'">True</Optimize>
    <SkipPostSharp Condition="'$(Configuration)' == 'Debug'">True</SkipPostSharp>
    <DebugSymbols Condition="'$(Configuration)' == 'Release'">true</DebugSymbols>
    <IncludeSymbols Condition="'$(Configuration)' == 'Release'">true</IncludeSymbols>
    <IsAotCompatible>False</IsAotCompatible>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
  </PropertyGroup>
  <Import Project="$(TitanManagedRoot)CSharpCode/Base/Base.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/CodeBuilder/CodeBuilder.projitems" Label="Shared" />
  <!-- 生成源码由 TitanConsumeManagedGeneratedInputs 在 CoreCompile 前校验并接入。 -->
  <Import Project="$(TitanManagedRoot)CSharpCode/Editor/Editor.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/GamePlay/GamePlay.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/ImGui/ImGui.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Math/Math.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Grapics/Mesh/Mesh.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Grapics/Pipeline/Pipeline.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/Procedure/Procedure.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Rtti/Rtti.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)3rd/csharp/StbImageSharp/StbImageSharp.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)3rd/csharp/StbImageWriteSharp/StbImageWriteSharp.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Platform/Windows/Windows.projitems" Label="Shared" Condition="'$(TitanPlatform)' == 'Windows'" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Platform/Mac/Mac.projitems" Label="Shared" Condition="'$(TitanPlatform)' == 'Mac'" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Platform/Android/Android.projitems" Label="Shared" Condition="'$(TitanPlatform)' == 'Android'" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/DataSet/DataSet.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/AssemblyLoader/AssemblyLoader.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/CSScripting/CSScripting.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/FBX/FBX.projitems" Label="Shared" Condition="'$(TitanPlatform)' == 'Windows'" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/Network/Network.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/Animation/Animation.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/Sequencer/Sequencer.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/CodeCompiler/CodeCompiler.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/WorldSimulator/WorldSimulator.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/TcpServer/TcpServer.projitems" Label="Shared" Condition="'$(TitanPlatform)' == 'Windows'" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/SourceControl/SourceControl.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/VXGI/VXGI.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/PhysicsCore/PhysicsCore.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/ProjectGen/ProjectGen.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/Terrain/Terrain.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/Input/Input.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/VirtualTexture/VirtualTexture.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/Particle/Particle.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/RenderPolicyEditor/RenderPolicyEditor.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/NodeGraph/NodeGraph.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/StateMachine/StateMachine.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)3rd/csharp/NvTriStrip/NvTriStrip.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/NxRHI/NxRHI.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/WindowSDL/WindowSDL.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/BehaviorTree/BehaviorTree.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/DesignMacross/DesignMacross.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/Recast/Recast.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/UI/UI.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)3rd/csharp/xxHash/xxHash.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/Collision/Collision.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/ImageDecoder/ImageDecoder.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/GpuDriven/GpuDriven.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/Font/Font.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)3rd/csharp/AstcDecoder/AstcDecoder.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/PythonRuntime/PythonRuntime.projitems" Label="Shared" Condition="'$(TitanPlatform)' == 'Windows'" />
  <Import Project="$(TitanManagedRoot)3rd/csharp/JitherOpenEXR/JitherOpenEXR.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/VirtualShadowMaps/VirtualShadowMaps.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/DestinyPX/NxMath/NxMath.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/DestinyPX/NxPhysics/NxPhysics.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/AssetImpExp/AssetImpExp.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/CompilingGenerator/CompilingGenerator.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/Localization/Localization.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/DistanceField/DistanceField.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/AdvanceShadow/AdvanceShadow.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)3rd/csharp/Sprache/Sprache.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/FX/Hair/Hair.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/FX/Skin/Skin.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/DataCopyer/DataCopyer.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/AIGC/AIGC.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/DevIDE/DevIDE.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/GI/PRT/PRT.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/Meshly/Meshly.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/FX/Water/Water.projitems" Label="Shared" />
  <Import Project="$(TitanManagedRoot)CSharpCode/Bricks/FX/Weather/Weather.projitems" Label="Shared" />
  <ItemGroup>
    <PackageReference Include="AssimpNetter" />
    <PackageReference Include="BCnEncoder.Net" />
    <PackageReference Include="MemoryInterop.ILPatcher" PrivateAssets="all" IncludeAssets="runtime; build; native; contentfiles; analyzers; buildtransitive" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Workspaces" />
    <PackageReference Include="Microsoft.CodeAnalysis.Workspaces.MSBuild" />
    <PackageReference Include="Mono.Cecil" />
    <PackageReference Include="NLua" />
    <PackageReference Include="NPOI" />
    <PackageReference Include="ppy.SDL3-CS" />
    <PackageReference Include="RIPEMD160" />
    <PackageReference Include="System.CodeDom" />
    <PackageReference Include="System.Runtime.Loader" />
    <ProjectReference Include="$(TitanManagedRoot)Module/CompilingGenerator/CompilingGenerator.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
    <ProjectReference Include="$(TitanManagedRoot)Module/LeanClrGenerator/LeanClrGenerator.csproj" />
    <ProjectReference Include="$(TitanManagedRoot)Module/TtEngineLints/TtEngineLints.csproj" OutputItemType="Analyzer" ReferenceOutputAssembly="false" />
  </ItemGroup>
  <Target Name="TitanValidateManagedProject" BeforeTargets="TitanValidatePlatform;BeforeBuild">
    <Error Condition="'$(TitanPlatform)' != '$(TitanEnginePlatform)'" Text="$(MSBuildProjectName) requires TitanPlatform=$(TitanEnginePlatform); got $(TitanPlatform)." />
    <Error Condition="'$(Configuration)' != 'Debug' and '$(Configuration)' != 'Release'" Text="Configuration must be Debug or Release." />
  </Target>
</Project>

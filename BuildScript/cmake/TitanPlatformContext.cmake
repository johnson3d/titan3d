include_guard(GLOBAL)

# 平台三元组唯一来源：目录名、托管工程、C++ 宏、变量前缀必须一一对应，
# 共享模块只按 TITAN_PLATFORM_* 取值，禁止在共享代码里写死平台名。
function(titan_platform_context platform project prefix)
  if(platform STREQUAL "Mac")
    set(_dir Core.Mac)
    set(_engine Engine.Mac)
    set(_macro PLATFORM_MAC)
    set(_prefix MAC)
  elseif(platform STREQUAL "Android")
    set(_dir Core.Android)
    set(_engine Engine.Android)
    set(_macro PLATFORM_DROID)
    set(_prefix ANDROID)
  else()
    message(FATAL_ERROR "不支持的平台上下文: ${platform}")
  endif()
  if(NOT project STREQUAL "${_dir}/${_dir}.vcxproj" OR NOT prefix STREQUAL _prefix)
    message(FATAL_ERROR "平台/工程/前缀不匹配: ${platform}, ${project}, ${prefix}")
  endif()
  set(TITAN_PLATFORM "${platform}" PARENT_SCOPE)
  set(TITAN_PLATFORM_PROJECT "${project}" PARENT_SCOPE)
  set(TITAN_PLATFORM_PREFIX "${prefix}" PARENT_SCOPE)
  set(TITAN_PLATFORM_DIR "${_dir}" PARENT_SCOPE)
  set(TITAN_PLATFORM_ENGINE "${_engine}" PARENT_SCOPE)
  set(TITAN_PLATFORM_MACRO "${_macro}" PARENT_SCOPE)
endfunction()

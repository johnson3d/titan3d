include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/TitanProjectMetadata.cmake")

# 解析 .vcxitems，返回参与编译的 ClCompile 源文件（正斜杠绝对路径）
function(titan_collect_vcxitems out_var vcxitems_path)
  if(NOT EXISTS "${vcxitems_path}")
    message(FATAL_ERROR "titan_collect_vcxitems: not found ${vcxitems_path}")
  endif()
  get_filename_component(_dir "${vcxitems_path}" DIRECTORY)
  file(READ "${vcxitems_path}" _content)
  # CMake 列表用 ';' 分隔，先屏蔽元数据里的分号
  string(REPLACE ";" "@SEMI@" _content "${_content}")
  string(REGEX MATCHALL "<ClCompile Include=\"[^\"]+\"[ \t]*/>" _singles "${_content}")
  string(REGEX MATCHALL "<ClCompile Include=\"[^\"]+\">[^<]*(<[^/][^<]*</[^>]+>[^<]*)*</ClCompile>" _blocks "${_content}")
  # 两条正则没覆盖到的写法会静默漏源，按出现次数核对
  string(REGEX MATCHALL "<ClCompile[ \t\r\n]" _all "${_content}")
  list(LENGTH _all _n_all)
  list(LENGTH _singles _n_singles)
  list(LENGTH _blocks _n_blocks)
  math(EXPR _n_matched "${_n_singles} + ${_n_blocks}")
  if(NOT _n_all EQUAL _n_matched)
    message(FATAL_ERROR "titan_collect_vcxitems: ${vcxitems_path} 有 ${_n_all} 个 ClCompile，只识别了 ${_n_matched} 个；请改成 <ClCompile Include=\"...\" /> 或带子元素的块写法")
  endif()
  set(_result)
  foreach(_item IN LISTS _singles _blocks)
    if(_item MATCHES "<ExcludedFromBuild[^>]*Condition=")
      # 按 Windows 配置条件排除的项在目标平台默认保留；需要剔除就写进平台 Modules.cmake 的排除规则
      message(WARNING "titan_collect_vcxitems: conditional ExcludedFromBuild kept for the target platform: ${_item}")
    elseif(_item MATCHES "<ExcludedFromBuild>[ \t\r\n]*true[ \t\r\n]*</ExcludedFromBuild>")
      continue()
    endif()
    string(REGEX MATCH "Include=\"([^\"]+)\"" _m "${_item}")
    set(_path "${CMAKE_MATCH_1}")
    string(REPLACE "$(MSBuildThisFileDirectory)" "${_dir}/" _path "${_path}")
    string(REPLACE "\\" "/" _path "${_path}")
    list(APPEND _result "${_path}")
  endforeach()
  set(${out_var} "${_result}" PARENT_SCOPE)
endfunction()

# 读取 vcxproj 中 Label="Shared" 的 .vcxitems Import，返回相对仓库根的路径
function(titan_read_vcxproj_imports out_var vcxproj_path titan_root)
  get_filename_component(_dir "${vcxproj_path}" DIRECTORY)
  file(READ "${vcxproj_path}" _content)
  string(REPLACE ";" "@SEMI@" _content "${_content}")
  string(REGEX MATCHALL "<Import[ \t\r\n][^>]+>" _tags "${_content}")
  set(_imps)
  foreach(_tag IN LISTS _tags)
    if(_tag MATCHES "Label=\"Shared\"" AND _tag MATCHES "Project=\"[^\"]+\\.vcxitems\"")
      list(APPEND _imps "${_tag}")
    endif()
  endforeach()
  set(_result)
  foreach(_imp IN LISTS _imps)
    string(REGEX MATCH "Project=\"([^\"]+)\"" _m "${_imp}")
    string(REPLACE "\\" "/" _p "${CMAKE_MATCH_1}")
    get_filename_component(_abs "${_dir}/${_p}" ABSOLUTE)
    file(RELATIVE_PATH _rel "${titan_root}" "${_abs}")
    list(APPEND _result "${_rel}")
  endforeach()
  list(REMOVE_DUPLICATES _result)
  set(${out_var} "${_result}" PARENT_SCOPE)
endfunction()

# 去掉 \r 后计算 SHA256，CRLF/LF 检出结果一致
function(titan_file_sha256_lf out_var path)
  file(READ "${path}" _c)
  string(REPLACE "\r" "" _c "${_c}")
  string(SHA256 _h "${_c}")
  set(${out_var} "${_h}" PARENT_SCOPE)
endfunction()

# ARGN 为相对仓库根的输入文件
function(titan_sources_fingerprint out_var titan_root)
  set(_acc "")
  foreach(_rel IN LISTS ARGN)
    if(NOT EXISTS "${titan_root}/${_rel}")
      message(FATAL_ERROR "[titan-sources] fingerprint input missing: ${_rel}")
    endif()
    titan_file_sha256_lf(_h "${titan_root}/${_rel}")
    string(APPEND _acc "${_rel}=${_h}\n")
  endforeach()
  string(SHA256 _fp "${_acc}")
  set(${out_var} "${_fp}" PARENT_SCOPE)
endfunction()

function(_titan_append_list content_var name)
  set(_c "${${content_var}}set(${name}\n")
  foreach(_i IN LISTS ARGN)
    string(APPEND _c "  \"${_i}\"\n")
  endforeach()
  string(APPEND _c ")\n")
  set(${content_var} "${_c}" PARENT_SCOPE)
endfunction()

# 生成 <平台目录>/generated/TitanSources.cmake 的完整内容
function(titan_render_sources out_var titan_root vcxproj_rel modules_file_rel)
  if(NOT TITAN_PLATFORM OR NOT TITAN_PLATFORM_PREFIX OR NOT TITAN_PLATFORM_DIR)
    message(FATAL_ERROR "[titan-sources] 先调用 titan_platform_context")
  endif()
  set(_prefix "TITAN_${TITAN_PLATFORM_PREFIX}")
  unset(TITAN_${TITAN_PLATFORM_PREFIX}_MODULES)
  set(TITAN_${TITAN_PLATFORM_PREFIX}_EXCLUDES)
  include("${titan_root}/${modules_file_rel}")
  if(DEFINED TITAN_${TITAN_PLATFORM_PREFIX}_MODULES)
    message(FATAL_ERROR "[titan-sources] ${vcxproj_rel} / CodeGen.vcxitems\n${modules_file_rel}: 不允许维护 TITAN_${TITAN_PLATFORM_PREFIX}_MODULES；请修改平台工程的 Shared Import，胶水单独处理")
  endif()
  titan_read_vcxproj_imports(_imports "${titan_root}/${vcxproj_rel}" "${titan_root}")
  list(FILTER _imports EXCLUDE REGEX "CodeGen\\.vcxitems$")
  if(NOT _imports)
    message(FATAL_ERROR "[titan-sources] ${vcxproj_rel} 缺少普通 Shared Import")
  endif()
  set(_inputs "${vcxproj_rel}" "${modules_file_rel}" "BuildScript/cmake/TitanSourceList.cmake" "BuildScript/cmake/TitanProjectMetadata.cmake")
  set(_dirs)
  set(_srcs)
  set(_module_defs "HasModule_${TITAN_PLATFORM}")
  foreach(_m IN LISTS _imports)
    get_filename_component(_module "${_m}" NAME_WLE)
    string(REPLACE "." "_" _module "${_module}")
    list(APPEND _module_defs "HasModule_${_module}")
    list(APPEND _inputs "${_m}")
    get_filename_component(_d "${_m}" DIRECTORY)
    list(APPEND _dirs "${_d}")
    titan_collect_vcxitems(_abs "${titan_root}/${_m}")
    foreach(_f IN LISTS _abs)
      get_filename_component(_f "${_f}" ABSOLUTE)
      if(NOT EXISTS "${_f}")
        message(FATAL_ERROR "[titan-sources] ${_m} 引用的源文件不存在: ${_f}")
      endif()
      file(RELATIVE_PATH _rel "${titan_root}" "${_f}")
      set(_skip FALSE)
      foreach(_re IN LISTS TITAN_${TITAN_PLATFORM_PREFIX}_EXCLUDES)
        if(_rel MATCHES "${_re}")
          set(_skip TRUE)
        endif()
      endforeach()
      if(NOT _skip)
        list(APPEND _srcs "${_rel}")
      endif()
    endforeach()
  endforeach()
  foreach(_pair "NextRHI|RHI" "NullDevice|VirtualDevice" "Canvas|TextFont")
    string(REPLACE "|" ";" _pair "${_pair}")
    list(GET _pair 0 _name)
    list(GET _pair 1 _alias)
    if("HasModule_${_name}" IN_LIST _module_defs)
      list(APPEND _module_defs "HasModule_${_alias}")
    endif()
  endforeach()
  list(REMOVE_DUPLICATES _module_defs)
  list(SORT _module_defs)
  list(REMOVE_DUPLICATES _srcs)
  list(SORT _srcs)
  titan_sources_fingerprint(_fp "${titan_root}" ${_inputs})
  list(LENGTH _srcs _n)
  set(_c "# 由 ${TITAN_PLATFORM_DIR}/RefreshSources.cmake 生成，勿手改。\n# 刷新（仓库根）: cmake -P ${TITAN_PLATFORM_DIR}/RefreshSources.cmake\n# sources: ${_n}\n")
  string(APPEND _c "set(TITAN_SOURCES_FINGERPRINT \"${_fp}\")\n")
  _titan_append_list(_c TITAN_SOURCES_INPUTS ${_inputs})
  _titan_append_list(_c ${_prefix}_MODULES ${_imports})
  _titan_append_list(_c ${_prefix}_MODULE_DEFINES ${_module_defs})
  _titan_append_list(_c TITAN_MODULE_DIRS ${_dirs})
  _titan_append_list(_c TITAN_MODULE_SOURCES ${_srcs})
  set(_source_defs)
  foreach(_config Debug Release)
    set(_incs)
    set(_defs)
    foreach(_input IN LISTS _inputs)
      if(NOT _input MATCHES "\\.vcx(proj|items)$")
        continue()
      endif()
      titan_read_metadata(_i _d _s "${titan_root}/${_input}" "${titan_root}" "${_config}")
      foreach(_include IN LISTS _i)
        file(RELATIVE_PATH _rel_include "${titan_root}" "${_include}")
        list(APPEND _incs "${_rel_include}")
      endforeach()
      list(APPEND _defs ${_d})
      list(APPEND _source_defs ${_s})
    endforeach()
    list(REMOVE_DUPLICATES _incs)
    list(REMOVE_DUPLICATES _defs)
    string(TOUPPER "${_config}" _upper)
    _titan_append_list(_c ${_prefix}_INCLUDES_${_upper} ${_incs})
    _titan_append_list(_c ${_prefix}_DEFINES_${_upper} ${_defs})
  endforeach()
  _titan_append_list(_c ${_prefix}_SOURCE_DEFINES ${_source_defs})
  set(${out_var}_MODULE_DEFINES "${_module_defs}" PARENT_SCOPE)
  set(${out_var}_FINGERPRINT "${_fp}" PARENT_SCOPE)
  set(${out_var} "${_c}" PARENT_SCOPE)
endfunction()

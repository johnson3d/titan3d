include_guard(GLOBAL)
include("${CMAKE_CURRENT_LIST_DIR}/TitanSourceList.cmake")

# 生成文件只在内容变化时写入；TITAN_CHECK 模式下内容不一致即报过期（CI 门禁）。
function(titan_check_or_write path content)
  set(_old "")
  if(EXISTS "${path}")
    file(READ "${path}" _old)
    string(REPLACE "\r" "" _old "${_old}")
  endif()
  if(TITAN_CHECK)
    if(NOT "${_old}" STREQUAL "${content}")
      message(FATAL_ERROR "[titan-sources] STALE: ${path}\n请运行 cmake -P ${TITAN_PLATFORM_DIR}/RefreshSources.cmake 并提交生成文件")
    endif()
  elseif(NOT "${_old}" STREQUAL "${content}")
    file(WRITE "${path}" "${content}")
    message(STATUS "[titan-sources] updated: ${path}")
  endif()
endfunction()

# 刷新当前平台的源清单、模块头和托管能力；调用前必须设置 TITAN_PLATFORM* 上下文与 TITAN_ROOT。
function(titan_refresh_platform_sources)
  if(NOT TITAN_PLATFORM OR NOT TITAN_ROOT)
    message(FATAL_ERROR "平台上下文或仓库根缺失")
  endif()
  if(NOT DEFINED TITAN_MODULES_FILE)
    set(TITAN_MODULES_FILE "${TITAN_PLATFORM_DIR}/${TITAN_PLATFORM}Modules.cmake")
  endif()
  if(NOT DEFINED TITAN_SOURCES_OUT)
    set(TITAN_SOURCES_OUT "${TITAN_ROOT}/${TITAN_PLATFORM_DIR}/generated/TitanSources.cmake")
  endif()
  titan_render_sources(_content "${TITAN_ROOT}" "${TITAN_PLATFORM_PROJECT}" "${TITAN_MODULES_FILE}")
  get_filename_component(_output_dir "${TITAN_SOURCES_OUT}" DIRECTORY)
  set(_header "#pragma once\n// 由 ${TITAN_PLATFORM_DIR}/RefreshSources.cmake 生成，勿手改。\n#define TITAN_${TITAN_PLATFORM_PREFIX}_MODULES_FINGERPRINT \"${_content_FINGERPRINT}\"\n")
  foreach(_define IN LISTS _content_MODULE_DEFINES)
    string(APPEND _header "#define ${_define}\n")
  endforeach()
  set(_capability_defines)
  set(_capabilities "// 由 ${TITAN_PLATFORM_DIR}/RefreshSources.cmake 生成，勿手改。\nnamespace EngineNS\n{\n    public static class TitanNativeCapabilities\n    {\n")
  set(_known ${_content_MODULE_DEFINES} HasModule_FBX HasModule_PythonRuntime HasModule_CrossShaderCompiler HasModule_TcpServer HasModule_PhysicsCore HasModule_NvPhysX5 HasModule_MeshSimplify HasModule_TextureCompress HasModule_Quark HasModule_Collision HasModule_Vulkan HasModule_Dx11 HasModule_Dx12 HasModule_RenderDoc HasModule_GpuDump)
  list(REMOVE_DUPLICATES _known)
  list(SORT _known)
  foreach(_define IN LISTS _known)
    if(_define IN_LIST _content_MODULE_DEFINES)
      set(_enabled true)
      string(REGEX REPLACE "^HasModule_" "" _name "${_define}")
      string(TOUPPER "${_name}" _name)
      list(APPEND _capability_defines "TITAN_HAS_${_name}")
    else()
      set(_enabled false)
    endif()
    string(APPEND _capabilities "        public const bool ${_define} = ${_enabled};\n")
  endforeach()
  string(APPEND _capabilities "    }\n}\n")
  list(JOIN _capability_defines ";" _capability_defines)
  set(_props "<Project>\n  <PropertyGroup>\n    <TitanNativeCapabilityDefines>${_capability_defines}</TitanNativeCapabilityDefines>\n    <TitanNativeCapabilitiesFingerprint>${_content_FINGERPRINT}</TitanNativeCapabilitiesFingerprint>\n  </PropertyGroup>\n  <ItemGroup><Compile Include=\"$(MSBuildThisFileDirectory)Titan${TITAN_PLATFORM}Capabilities.cs\" TitanGenerated=\"true\" /></ItemGroup>\n</Project>\n")
  titan_check_or_write("${TITAN_SOURCES_OUT}" "${_content}")
  titan_check_or_write("${_output_dir}/Titan${TITAN_PLATFORM}Modules.h" "${_header}")
  titan_check_or_write("${_output_dir}/Titan${TITAN_PLATFORM}Capabilities.props" "${_props}")
  titan_check_or_write("${_output_dir}/Titan${TITAN_PLATFORM}Capabilities.cs" "${_capabilities}")
  message(STATUS "[titan-sources] ${TITAN_PLATFORM} up to date")
endfunction()

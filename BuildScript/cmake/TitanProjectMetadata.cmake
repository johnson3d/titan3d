include_guard(GLOBAL)

# 仅支持仓库实际使用的配置条件，遇到其他形式不静默丢失元数据。
function(titan_condition_matches out tag config)
  string(REGEX MATCH "Condition=\"([^\"]+)\"" _m "${tag}")
  if(NOT _m)
    set(${out} TRUE PARENT_SCOPE)
    return()
  endif()
  set(_condition "${CMAKE_MATCH_1}")
  string(REGEX REPLACE "[ \t\r\n]" "" _condition "${_condition}")
  if(_condition STREQUAL "'$(Configuration)'=='${config}'" OR _condition STREQUAL "'$(Configuration)|$(Platform)'=='${config}|ARM64'")
    set(${out} TRUE PARENT_SCOPE)
  elseif(_condition MATCHES "^'\\$\\(Configuration\\)'=='(Debug|Release)'$" OR _condition MATCHES "^'\\$\\(Configuration\\)\\|\\$\\(Platform\\)'=='(Debug|Release)\\|(ARM64|x64|Win32)'$")
    set(${out} FALSE PARENT_SCOPE)
  else()
    message(FATAL_ERROR "[titan-metadata] 不支持条件: ${_condition}")
  endif()
endfunction()

function(titan_metadata_values out content element config base is_path)
  string(REGEX MATCHALL "<${element}[^>]*>[^<]*</${element}>" _items "${content}")
  set(_values)
  foreach(_item IN LISTS _items)
    string(REGEX MATCH "^[^>]*>" _tag "${_item}")
    titan_condition_matches(_enabled "${_tag}" "${config}")
    if(NOT _enabled)
      continue()
    endif()
    string(REGEX REPLACE "^<${element}[^>]*>([^<]*)</${element}>$" "\\1" _text "${_item}")
    string(REPLACE "@SEMI@" ";" _text "${_text}")
    foreach(_value IN LISTS _text)
      string(STRIP "${_value}" _value)
      if(_value STREQUAL "" OR _value MATCHES "^%\\(")
        continue()
      endif()
      string(REPLACE "$(MSBuildThisFileDirectory)" "${base}/" _value "${_value}")
      if(_value MATCHES "\\$\\(")
        message(FATAL_ERROR "[titan-metadata] 未解析属性: ${_value}")
      endif()
      if(is_path)
        string(REPLACE "\\" "/" _value "${_value}")
        get_filename_component(_value "${_value}" ABSOLUTE BASE_DIR "${base}")
      endif()
      list(APPEND _values "${_value}")
    endforeach()
  endforeach()
  set(${out} "${_values}" PARENT_SCOPE)
endfunction()

# 返回工程/共享项级 include、定义及源文件级定义（源路径|配置|宏）。
function(titan_read_metadata out_includes out_defines out_sources file root config)
  file(READ "${file}" _text)
  string(REPLACE ";" "@SEMI@" _text "${_text}")
  get_filename_component(_base "${file}" DIRECTORY)
  string(REPLACE "</ItemDefinitionGroup>" "</ItemDefinitionGroup>;" _chunks "${_text}")
  set(_incs)
  set(_defs)
  set(_source_defs)
  set(_matched FALSE)
  foreach(_chunk IN LISTS _chunks)
    string(FIND "${_chunk}" "<ItemDefinitionGroup" _start REVERSE)
    if(_start LESS 0)
      continue()
    endif()
    string(SUBSTRING "${_chunk}" ${_start} -1 _group)
    string(REGEX MATCH "^[^>]*>" _tag "${_group}")
    titan_condition_matches(_enabled "${_tag}" "${config}")
    if(NOT _enabled)
      continue()
    endif()
    if(_tag MATCHES "Condition=")
      set(_matched TRUE)
    endif()
    titan_metadata_values(_i "${_group}" AdditionalIncludeDirectories "${config}" "${_base}" TRUE)
    titan_metadata_values(_d "${_group}" PreprocessorDefinitions "${config}" "${_base}" FALSE)
    list(APPEND _incs ${_i})
    list(APPEND _defs ${_d})
  endforeach()
  if(file MATCHES "\\.vcxproj$" AND NOT _matched)
    message(FATAL_ERROR "[titan-metadata] ${file} 缺少 ${config}|ARM64 配置")
  endif()
  string(REGEX MATCHALL "<ClCompile Include=\"[^\"]+\">[^<]*(<[^/][^<]*</[^>]+>[^<]*)*</ClCompile>" _blocks "${_text}")
  foreach(_block IN LISTS _blocks)
    string(REGEX MATCH "Include=\"([^\"]+)\"" _m "${_block}")
    set(_source "${CMAKE_MATCH_1}")
    string(REPLACE "$(MSBuildThisFileDirectory)" "${_base}/" _source "${_source}")
    string(REPLACE "\\" "/" _source "${_source}")
    get_filename_component(_source "${_source}" ABSOLUTE BASE_DIR "${_base}")
    file(RELATIVE_PATH _source "${root}" "${_source}")
    titan_metadata_values(_d "${_block}" PreprocessorDefinitions "${config}" "${_base}" FALSE)
    foreach(_define IN LISTS _d)
      list(APPEND _source_defs "${_source}|${config}|${_define}")
    endforeach()
  endforeach()
  set(${out_includes} "${_incs}" PARENT_SCOPE)
  set(${out_defines} "${_defs}" PARENT_SCOPE)
  set(${out_sources} "${_source_defs}" PARENT_SCOPE)
endfunction()

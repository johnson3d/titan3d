function(test_codegen_inputs_fingerprint)
  titan_codegen_inputs_fingerprint(fingerprint inputs "${TITAN_ROOT}")
  list(LENGTH inputs count)
  string(JOIN "|" joined ${inputs})
  if(count LESS 100 OR NOT fingerprint MATCHES "^[0-9a-f]+$"
     OR NOT joined MATCHES "NativeCode.Base.BaseHead\\.h"
     OR NOT joined MATCHES "Module.CppWeavingTools.PlatformProject\\.cs"
     OR NOT joined MATCHES "BuildScript.msbuild.TitanPlatform\\.props"
     OR NOT joined MATCHES "Core.Mac.generated.TitanMacCapabilities\\.props"
     OR NOT joined MATCHES "Rpc_Engine\\.txt"
     OR NOT joined MATCHES "Module.Engine.Mac.Engine.Mac\\.csproj"
     OR NOT joined MATCHES "BuildScript.msbuild.TitanManagedEngine\\.props"
     OR NOT joined MATCHES "BuildScript.msbuild.TitanSourceInputs\\.targets"
     OR NOT joined MATCHES "Plugins.*\\.csproj"
     OR NOT joined MATCHES "codegen.Templates.Empty_CodeGen\\.vcxitems")
    message(FATAL_ERROR "Mac codegen 输入闭包不完整: count=${count}, fingerprint=${fingerprint}")
  endif()
  message(STATUS "[titan-cmake-tests] PASS test_codegen_inputs_fingerprint")
endfunction()

function(test_codegen_inputs_ignore_build_outputs)
  set(root "${TEST_TMP}/fingerprint-root")
  file(MAKE_DIRECTORY "${root}/Core.Mac" "${root}/NativeCode")
  file(WRITE "${root}/Core.Mac/pch.h" "#pragma once\n")
  file(WRITE "${root}/NativeCode/Input.h" "#pragma once\n")
  unset(TITAN_MAC_MODULES)
  titan_codegen_inputs_fingerprint(before before_inputs "${root}")
  string(JOIN "|" before_joined ${before_inputs})
  if(NOT before_joined MATCHES "Core.Mac.pch\\.h")
    message(FATAL_ERROR "Mac codegen 输入指纹遗漏真实源码: ${before_joined}")
  endif()
  file(MAKE_DIRECTORY
    "${root}/Core.Mac/build/codegen_norm/codegen/Mac/NativeBinder"
    "${root}/Core.Mac/build-release/codegen_norm"
    "${root}/Module/CppWeavingTools/bin"
    "${root}/Module/CppWeavingTools/obj")
  file(WRITE "${root}/Core.Mac/build/codegen_norm/codegen/Mac/NativeBinder/PODStructDefine.h" "generated\n")
  file(WRITE "${root}/Core.Mac/build-release/codegen_norm/Generated.h" "generated\n")
  file(WRITE "${root}/Module/CppWeavingTools/bin/Generated.cs" "generated\n")
  file(WRITE "${root}/Module/CppWeavingTools/obj/Generated.cs" "generated\n")
  titan_codegen_inputs_fingerprint(after after_inputs "${root}")
  string(JOIN "|" joined ${after_inputs})
  if(NOT before STREQUAL after OR joined MATCHES "Core.Mac.build|CppWeavingTools.(bin|obj)")
    message(FATAL_ERROR "Mac codegen 输入指纹包含构建输出: before=${before}, after=${after}, inputs=${joined}")
  endif()
  file(WRITE "${root}/Core.Mac/Extra.h" "#pragma once\n")
  titan_codegen_inputs_fingerprint(source_after source_inputs "${root}")
  string(JOIN "|" source_joined ${source_inputs})
  if(before STREQUAL source_after OR NOT source_joined MATCHES "Core.Mac.Extra\\.h")
    message(FATAL_ERROR "Mac codegen 输入指纹未跟踪新增源码: before=${before}, after=${source_after}, inputs=${source_joined}")
  endif()
  # 工程/import/插件描述/模板的增删改必须改变指纹，平台生成目录不得反馈到输入。
  foreach(input
      Module/Engine.Mac/Engine.Mac.csproj
      BuildScript/msbuild/TitanManagedEngine.props
      BuildScript/msbuild/TitanSourceInputs.targets
      Plugins/Probe/Probe.All.csproj
      Plugins/Probe/Probe.plugin
      codegen/Templates/Empty_CodeGen.vcxitems)
    get_filename_component(dir "${root}/${input}" DIRECTORY)
    file(MAKE_DIRECTORY "${dir}")
    titan_codegen_inputs_fingerprint(previous unused "${root}")
    file(WRITE "${root}/${input}" "input v1\n")
    titan_codegen_inputs_fingerprint(added unused "${root}")
    file(WRITE "${root}/${input}" "input v2\n")
    titan_codegen_inputs_fingerprint(changed unused "${root}")
    file(REMOVE "${root}/${input}")
    titan_codegen_inputs_fingerprint(removed unused "${root}")
    if(previous STREQUAL added OR added STREQUAL changed OR NOT previous STREQUAL removed)
      message(FATAL_ERROR "指纹未跟踪工程输入增删改: ${input}")
    endif()
  endforeach()
  titan_codegen_inputs_fingerprint(previous unused "${root}")
  file(MAKE_DIRECTORY "${root}/codegen/Mac/NativeBinder" "${root}/codegen/Windows/NativeBinder")
  file(WRITE "${root}/codegen/Mac/NativeBinder/Generated.h" "Mac output\n")
  file(WRITE "${root}/codegen/Windows/NativeBinder/Generated.h" "Windows output\n")
  titan_codegen_inputs_fingerprint(generated unused "${root}")
  if(NOT previous STREQUAL generated)
    message(FATAL_ERROR "平台生成输出污染输入指纹")
  endif()
  message(STATUS "[titan-cmake-tests] PASS test_codegen_inputs_ignore_build_outputs")
endfunction()


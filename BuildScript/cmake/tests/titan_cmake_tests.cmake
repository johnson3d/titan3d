function(test_refresh_roundtrip)
  set(out "${TEST_TMP}/TitanSources.cmake")
  run_refresh(rc log "-DTITAN_SOURCES_OUT=${out}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "test_refresh_roundtrip: refresh failed (${rc}):\n${log}")
  endif()
  file(READ "${out}" content)
  if(NOT content MATCHES "set\\(TITAN_SOURCES_FINGERPRINT \"[0-9a-f]+\"\\)")
    message(FATAL_ERROR "test_refresh_roundtrip: fingerprint missing:\n${content}")
  endif()
  if(NOT content MATCHES "\"NativeCode/Base/io/vfxfile\\.cpp\"")
    message(FATAL_ERROR "test_refresh_roundtrip: Base sources missing:\n${content}")
  endif()
  if(content MATCHES "cpp2cs")
    message(FATAL_ERROR "test_refresh_roundtrip: glue leaked into module sources")
  endif()
  run_refresh(rc log "-DTITAN_SOURCES_OUT=${out}" -DTITAN_CHECK=ON)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "test_refresh_roundtrip: fresh file reported stale:\n${log}")
  endif()
  if(NOT EXISTS "${TEST_TMP}/TitanMacModules.h")
    message(FATAL_ERROR "Mac 模块头未随源清单生成")
  endif()
  file(READ "${TEST_TMP}/TitanMacModules.h" modules)
  if(NOT modules MATCHES "HasModule_Image_Shared" OR modules MATCHES "HasModule_FBX")
    message(FATAL_ERROR "Mac 模块头命名或 SDK 隔离错误")
  endif()
  file(APPEND "${out}" "# tampered\n")
  run_refresh(rc log "-DTITAN_SOURCES_OUT=${out}" -DTITAN_CHECK=ON)
  if(rc EQUAL 0 OR NOT log MATCHES "RefreshSources\\.cmake")
    message(FATAL_ERROR "test_refresh_roundtrip: tampered file not detected (${rc}):\n${log}")
  endif()
  message(STATUS "[titan-cmake-tests] PASS test_refresh_roundtrip")
endfunction()


# 生成物写入隔离目录，不碰正式清单；只校验 Android 平台口径与过期门禁
function(test_android_refresh_roundtrip)
  set(_out "${TEST_TMP}/android/TitanSources.cmake")
  run_android_refresh(rc log "-DTITAN_SOURCES_OUT=${_out}")
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "Android refresh 失败 (${rc}):\n${log}")
  endif()
  file(READ "${_out}" _content)
  if(NOT _content MATCHES "TITAN_ANDROID_MODULES")
    message(FATAL_ERROR "Android 清单缺少 TITAN_ANDROID_MODULES:\n${_content}")
  endif()
  if(NOT _content MATCHES "PLATFORM_DROID")
    message(FATAL_ERROR "Android 清单缺少 PLATFORM_DROID:\n${_content}")
  endif()
  if(_content MATCHES "PLATFORM_WIN")
    message(FATAL_ERROR "Android 清单平台污染 (PLATFORM_WIN):\n${_content}")
  endif()
  if(NOT EXISTS "${TEST_TMP}/android/TitanAndroidModules.h")
    message(FATAL_ERROR "Android 模块头未写入隔离目录")
  endif()
  run_android_refresh(rc log "-DTITAN_SOURCES_OUT=${_out}" -DTITAN_CHECK=ON)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "新 Android 清单被错误判定为过期:\n${log}")
  endif()
  file(APPEND "${_out}" "# tampered\n")
  run_android_refresh(rc log "-DTITAN_SOURCES_OUT=${_out}" -DTITAN_CHECK=ON)
  if(rc EQUAL 0)
    message(FATAL_ERROR "Android 过期清单被放行")
  endif()
  message(STATUS "[titan-cmake-tests] PASS test_android_refresh_roundtrip")
endfunction()

# 与 Mac 同构：Android stamp 必须匹配平台、配置、源码指纹、输入指纹
function(test_android_glue_isolation_and_stamp)
  set(root "${TEST_TMP}/glue-root-android")
  set(glue "${root}/codegen/Android/NativeBinder")
  file(MAKE_DIRECTORY "${glue}" "${root}/codegen/Mac/NativeBinder" "${root}/NativeCode")
  file(WRITE "${glue}/PODStructDefine.h" "#pragma once\n")
  file(WRITE "${glue}/Portable.cpp2cs.cpp" "#include \"/home/a/titanengine/Core.Android/pch.h\"\n")
  file(WRITE "${root}/codegen/Mac/NativeBinder/PODStructDefine.h" "mac sentinel\n")
  file(WRITE "${root}/codegen/Mac/NativeBinder/Mac.cpp2cs.cpp" "mac sentinel\n")
  file(WRITE "${root}/NativeCode/Input.h" "#pragma once\n")
  titan_platform_context(Android "Core.Android/Core.Android.vcxproj" ANDROID)
  unset(TITAN_ANDROID_MODULES)
  titan_codegen_inputs_fingerprint(inputs_fingerprint codegen_inputs "${root}")
  file(WRITE "${root}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.24)\nproject(AndroidGlueTest LANGUAGES NONE)\ninclude(\"${TITAN_ROOT}/BuildScript/cmake/TitanPlatformContext.cmake\")\ntitan_platform_context(Android \"Core.Android/Core.Android.vcxproj\" ANDROID)\ninclude(\"${TITAN_ROOT}/BuildScript/cmake/TitanCodegen.cmake\")\nset(CMAKE_BUILD_TYPE Debug)\nset(TITAN_SOURCES_FINGERPRINT test-fingerprint)\ntitan_prepare_codegen(files \"${root}\" \"${root}/normalized\")\nfile(WRITE \"${root}/result.txt\" \"\$\{files\}\")\n")
  foreach(stage missing wrong-platform source-stale valid)
    if(stage STREQUAL wrong-platform)
      file(WRITE "${glue}/.codegen.stamp" "{\"platform\":\"Mac\",\"configuration\":\"Debug\",\"fingerprint\":\"test-fingerprint\",\"inputsFingerprint\":\"${inputs_fingerprint}\",\"parseFailures\":0}")
    elseif(stage STREQUAL source-stale)
      file(WRITE "${glue}/.codegen.stamp" "{\"platform\":\"Android\",\"configuration\":\"Debug\",\"fingerprint\":\"test-fingerprint\",\"inputsFingerprint\":\"bad\",\"parseFailures\":0}")
    elseif(stage STREQUAL valid)
      file(WRITE "${glue}/.codegen.stamp" "{\"platform\":\"Android\",\"configuration\":\"Debug\",\"fingerprint\":\"test-fingerprint\",\"inputsFingerprint\":\"${inputs_fingerprint}\",\"parseFailures\":0}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${root}" -B "${root}/build-${stage}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(stage STREQUAL valid)
      if(NOT rc EQUAL 0)
        message(FATAL_ERROR "Android glue valid stamp rejected: ${out}${err}")
      endif()
      file(READ "${root}/result.txt" result)
      if(NOT result STREQUAL "${root}/normalized/codegen/Android/NativeBinder/Portable.cpp2cs.cpp")
        message(FATAL_ERROR "Mac glue leaked into Android build: ${result}")
      endif()
    else()
      if(rc EQUAL 0)
        message(FATAL_ERROR "Android glue ${stage} stamp was accepted")
      endif()
      if(NOT stage STREQUAL missing AND NOT "${out}${err}" MATCHES "stale or diagnostic .*stamp")
        message(FATAL_ERROR "Android glue ${stage} stamp: 诊断文案未指向 stale stamp:\n${out}${err}")
      endif()
    endif()
  endforeach()
  message(STATUS "[titan-cmake-tests] PASS test_android_glue_isolation_and_stamp")
endfunction()


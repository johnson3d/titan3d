function(test_setup_entry_contract)
  set(mac_setup "${TITAN_ROOT}/Core.Mac/setup.sh")
  set(root_setup "${TITAN_ROOT}/setup.sh")
  foreach(f "${mac_setup}" "${root_setup}")
    if(NOT EXISTS "${f}")
      message(FATAL_ERROR "test_setup_entry_contract: missing ${f}")
    endif()
  endforeach()
  file(READ "${mac_setup}" content)
  # 顺序契约: 依赖校验 -> codegen -> configure -> build，缺一不可
  string(FIND "${content}" "GenerateCodegen.cmake" p_codegen)
  string(FIND "${content}" "-S Core.Mac -B" p_configure)
  string(FIND "${content}" "--build" p_build)
  string(FIND "${content}" "install-mac" p_libcxx)
  if(p_codegen EQUAL -1 OR p_configure EQUAL -1 OR p_build EQUAL -1 OR p_libcxx EQUAL -1)
    message(FATAL_ERROR "test_setup_entry_contract: setup.sh 缺少必要步骤 (codegen=${p_codegen} configure=${p_configure} build=${p_build} libcxx=${p_libcxx})")
  endif()
  if(NOT p_codegen LESS p_configure OR NOT p_configure LESS p_build)
    message(FATAL_ERROR "test_setup_entry_contract: setup.sh 步骤顺序错误: codegen 必须先于 configure，configure 必须先于 build")
  endif()
  # configure 必须由 build.ninja 缺失检查守卫（根治全新 clone 直接 --build 报目录不存在）
  if(NOT content MATCHES "build\\.ninja")
    message(FATAL_ERROR "test_setup_entry_contract: setup.sh 缺少 build.ninja 存在性守卫")
  endif()
  file(READ "${root_setup}" content)
  if(NOT content MATCHES "Core\\.Mac/setup\\.sh")
    message(FATAL_ERROR "test_setup_entry_contract: 根 setup.sh 未分发到 Core.Mac/setup.sh")
  endif()
  # Windows 分支: build.ps1 -CodeGenOnly（configure 语义）与 deps.ps1 只检查入口
  if(NOT content MATCHES "build\\.ps1 -CodeGenOnly" OR NOT content MATCHES "check/deps\\.ps1")
    message(FATAL_ERROR "test_setup_entry_contract: 根 setup.sh 缺少 Windows 分支（build.ps1 -CodeGenOnly / check/deps.ps1）")
  endif()
  file(READ "${TITAN_ROOT}/Setup.bat" bat)
  if(NOT bat MATCHES "build\\.ps1. -CodeGenOnly")
    message(FATAL_ERROR "test_setup_entry_contract: Setup.bat 未接入 build.ps1 -CodeGenOnly（仍为过时遗留）")
  endif()
  file(READ "${TITAN_ROOT}/.vscode/tasks.json" tasks)
  if(NOT tasks MATCHES "Titan: Setup & Build Native \\(Debug\\)" OR NOT tasks MATCHES "\\$\\{workspaceFolder\\}/setup\\.sh")
    message(FATAL_ERROR "test_setup_entry_contract: .vscode/tasks.json 缺少 setup.sh 构建任务")
  endif()
  message(STATUS "[titan-cmake-tests] PASS test_setup_entry_contract")
endfunction()


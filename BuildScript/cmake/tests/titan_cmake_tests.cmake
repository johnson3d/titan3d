  endif()
  if(NOT cml MATCHES "libvulkan.so")
    message(FATAL_ERROR "test_android_vulkan_stub_level: link must pass the stub path explicitly")
  endif()
  message(STATUS "[titan-cmake-tests] PASS test_android_vulkan_stub_level")
endfunction()

# 托管 Engine.Android 无条件接入 NxPhysics/DestinyPX 与 LeanCLR；原生工程不导入对应 vcxitems 时
# 胶水里没有这些绑定，Engine.Android 会以 CS0246/CS0234 失败。
function(test_android_native_binding_modules)
  file(READ "${TITAN_ROOT}/Core.Android/Core.Android.vcxproj" proj)

function(test_normalize_real_glue)
  file(GLOB_RECURSE glue "${TITAN_ROOT}/codegen/Windows/NativeBinder/*.cpp2cs.cpp")
  if(NOT glue)
    message(STATUS "[titan-cmake-tests] SKIP test_normalize_real_glue (codegen 不存在)")
    return()
  endif()
  list(GET glue 0 first)
  titan_normalize_file("${first}" "${TEST_TMP}/glue.cpp" "${TITAN_ROOT}")
  titan_normalize_file("${TITAN_ROOT}/codegen/Windows/NativeBinder/PODStructDefine.h" "${TEST_TMP}/PODStructDefine.h" "${TITAN_ROOT}")
  foreach(f "${TEST_TMP}/glue.cpp" "${TEST_TMP}/PODStructDefine.h")
    file(READ "${f}" out)
    if(out MATCHES "#include \"([A-Za-z]:|/)")
      message(FATAL_ERROR "test_normalize_real_glue: absolute include left in ${f}")
    endif()
    if(NOT out MATCHES "#include \"(Core\\.Window|NativeCode|codegen)/")
      message(FATAL_ERROR "test_normalize_real_glue: no relative include produced in ${f}")
    endif()
  endforeach()
  # 全量：不得残留任何形态的绝对 include，改写后的相对 include 必须存在
  foreach(g IN LISTS glue ITEMS "${TITAN_ROOT}/codegen/Windows/NativeBinder/PODStructDefine.h")
    file(READ "${g}" out)
    titan_normalize_include_paths(out "${TITAN_ROOT}")
    if(out MATCHES "#[ \t]*include[ \t]*[<\"]([A-Za-z]:|/)")
      message(FATAL_ERROR "test_normalize_real_glue: absolute include left after normalizing ${g}")
    endif()
    string(REGEX MATCHALL "#include \"(Core\\.Window|NativeCode|codegen|3rd)/[^\"]+\"" incs "${out}")
    foreach(inc IN LISTS incs)
      string(REGEX REPLACE "^#include \"(.*)\"$" "\\1" rel "${inc}")
      if(NOT EXISTS "${TITAN_ROOT}/${rel}")
        message(FATAL_ERROR "test_normalize_real_glue: ${g} -> missing ${rel}")
      endif()
    endforeach()
  endforeach()
  message(STATUS "[titan-cmake-tests] PASS test_normalize_real_glue")
endfunction()


  titan_codegen_inputs_fingerprint(inputs_fingerprint codegen_inputs "${root}")
  file(WRITE "${root}/CMakeLists.txt" "cmake_minimum_required(VERSION 3.24)\nproject(GlueTest LANGUAGES NONE)\ninclude(\"${TITAN_ROOT}/BuildScript/cmake/TitanPlatformContext.cmake\")\ntitan_platform_context(Mac \"Core.Mac/Core.Mac.vcxproj\" MAC)\ninclude(\"${TITAN_ROOT}/BuildScript/cmake/TitanCodegen.cmake\")\nset(CMAKE_BUILD_TYPE Debug)\nset(TITAN_SOURCES_FINGERPRINT test-fingerprint)\ntitan_prepare_codegen(files \"${root}\" \"${root}/normalized\")\nfile(WRITE \"${root}/result.txt\" \"\$\{files\}\")\n")
  foreach(stage missing stale source-stale valid)
    if(stage STREQUAL stale)
      file(WRITE "${glue}/.codegen.stamp" "{\"platform\":\"Mac\",\"configuration\":\"Release\",\"fingerprint\":\"test-fingerprint\",\"inputsFingerprint\":\"${inputs_fingerprint}\",\"parseFailures\":0}")
    elseif(stage STREQUAL source-stale)
      file(WRITE "${glue}/.codegen.stamp" "{\"platform\":\"Mac\",\"configuration\":\"Debug\",\"fingerprint\":\"test-fingerprint\",\"inputsFingerprint\":\"stale\",\"parseFailures\":0}")
    elseif(stage STREQUAL valid)
      file(WRITE "${glue}/.codegen.stamp" "{\"platform\":\"Mac\",\"configuration\":\"Debug\",\"fingerprint\":\"test-fingerprint\",\"inputsFingerprint\":\"${inputs_fingerprint}\",\"parseFailures\":0}")
    endif()
    execute_process(COMMAND "${CMAKE_COMMAND}" -S "${root}" -B "${root}/build-${stage}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(stage STREQUAL valid)
      if(NOT rc EQUAL 0)
        message(FATAL_ERROR "Mac glue valid stamp rejected: ${out}${err}")
      endif()
      file(READ "${root}/result.txt" result)
      if(NOT result STREQUAL "${root}/normalized/codegen/Mac/NativeBinder/Portable.cpp2cs.cpp")
        message(FATAL_ERROR "Windows glue leaked into Mac build: ${result}")
      endif()
    elseif(rc EQUAL 0)
      message(FATAL_ERROR "Mac glue ${stage} stamp was accepted")
    endif()
  endforeach()
  message(STATUS "[titan-cmake-tests] PASS test_mac_glue_isolation_and_stamp")
endfunction()

function(test_unconditional_metadata_does_not_hide_missing_configuration)
  set(project "${TEST_TMP}/Metadata.vcxproj")
  file(WRITE "${project}" "<Project><ItemDefinitionGroup><ClCompile><PreprocessorDefinitions>COMMON</PreprocessorDefinitions></ClCompile></ItemDefinitionGroup><ItemDefinitionGroup Condition=\"'$(Configuration)|$(Platform)'=='Release|ARM64'\"><ClCompile><PreprocessorDefinitions>RELEASE_ONLY</PreprocessorDefinitions></ClCompile></ItemDefinitionGroup></Project>")
  foreach(config Debug Release)
    set(script "${TEST_TMP}/metadata-${config}.cmake")
    file(WRITE "${script}" "include(\"${TITAN_ROOT}/BuildScript/cmake/TitanProjectMetadata.cmake\")\ntitan_read_metadata(i d s \"${project}\" \"${TITAN_ROOT}\" ${config})\nfile(WRITE \"${TEST_TMP}/metadata-result.txt\" \"\$\{d\}\")\n")
    execute_process(COMMAND "${CMAKE_COMMAND}" -P "${script}" RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
    if(config STREQUAL Debug)
      if(rc EQUAL 0 OR NOT "${out}${err}" MATCHES "Debug")
        message(FATAL_ERROR "无条件组掩盖缺失配置: ${out}${err}")
      endif()
    else()
      if(NOT rc EQUAL 0)
        message(FATAL_ERROR "有效 Release 配置被拒绝: ${out}${err}")
      endif()
      file(READ "${TEST_TMP}/metadata-result.txt" result)
      if(NOT result STREQUAL "COMMON;RELEASE_ONLY")
        message(FATAL_ERROR "无条件/选定配置元数据遗漏: ${result}")
      endif()
    endif()
  endforeach()
  message(STATUS "[titan-cmake-tests] PASS test_unconditional_metadata_does_not_hide_missing_configuration")
endfunction()


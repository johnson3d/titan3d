# 用法（仓库根）: cmake -P BuildScript/cmake/tests/titan_cmake_tests.cmake
# 共享 CMake 模块（源码清单/胶水/元数据）在 BuildScript/cmake/，各平台目录只保留入口与平台 flags。
cmake_minimum_required(VERSION 3.24)
get_filename_component(TITAN_ROOT "${CMAKE_CURRENT_LIST_DIR}/../../.." ABSOLUTE)
include("${CMAKE_CURRENT_LIST_DIR}/../TitanPlatformContext.cmake")
titan_platform_context(Mac "Core.Mac/Core.Mac.vcxproj" MAC)
include("${CMAKE_CURRENT_LIST_DIR}/../TitanSourceList.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/../TitanCodegen.cmake")

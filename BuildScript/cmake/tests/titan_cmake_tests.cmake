# 平台映射是共享模块的唯一平台来源；在函数内调用，避免改写脚本作用域的 Mac 上下文。
function(test_android_context)
  titan_platform_context(Android "Core.Android/Core.Android.vcxproj" ANDROID)
  if(NOT TITAN_PLATFORM_ENGINE STREQUAL "Engine.Android" OR
     NOT TITAN_PLATFORM_MACRO STREQUAL "PLATFORM_DROID" OR
     NOT TITAN_PLATFORM_PREFIX STREQUAL "ANDROID" OR
     NOT TITAN_PLATFORM_DIR STREQUAL "Core.Android")
    message(FATAL_ERROR "Android context 映射错误")
  endif()
  message(STATUS "[titan-cmake-tests] PASS test_android_context")
endfunction()
test_android_context()

set(TEST_TMP_REL "intermediate/titan_cmake_tests")
set(TEST_TMP "${TITAN_ROOT}/${TEST_TMP_REL}")
set(REFRESH "${TITAN_ROOT}/Core.Mac/RefreshSources.cmake")
file(REMOVE_RECURSE "${TEST_TMP}")
file(MAKE_DIRECTORY "${TEST_TMP}")

# 子进程运行刷新命令；ARGN 为 -D 参数
function(run_refresh rc_var log_var)
  execute_process(COMMAND "${CMAKE_COMMAND}" ${ARGN} -P "${REFRESH}"
    WORKING_DIRECTORY "${TITAN_ROOT}"
    RESULT_VARIABLE _rc OUTPUT_VARIABLE _out ERROR_VARIABLE _err)
  set(${rc_var} "${_rc}" PARENT_SCOPE)
  set(${log_var} "${_out}${_err}" PARENT_SCOPE)
endfunction()

function(test_collect_base)
  titan_collect_vcxitems(srcs "${TITAN_ROOT}/NativeCode/Base/Base.vcxitems")
  list(LENGTH srcs n)
  if(NOT n EQUAL 33)
    message(FATAL_ERROR "test_collect_base: expected 33 sources, got ${n}: ${srcs}")
  endif()
  set(hit ${srcs})
  list(FILTER hit INCLUDE REGEX "/NativeCode/Base/io/vfxfile\\.cpp$")
  if(NOT hit)
    message(FATAL_ERROR "test_collect_base: io/vfxfile.cpp missing")
  endif()
  set(excluded ${srcs})
  list(FILTER excluded INCLUDE REGEX "vfxfile_(Android|IOS)\\.cpp$")
  if(excluded)
    message(FATAL_ERROR "test_collect_base: ExcludedFromBuild items leaked: ${excluded}")
  endif()
  foreach(f IN LISTS srcs)
    if(NOT EXISTS "${f}")
      message(FATAL_ERROR "test_collect_base: path does not exist: ${f}")
    endif()
  endforeach()
  message(STATUS "[titan-cmake-tests] PASS test_collect_base")
endfunction()

function(test_collect_block_with_semicolon)

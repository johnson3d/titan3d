function(test_read_imports)
  titan_read_vcxproj_imports(imps "${TITAN_ROOT}/Core.Window/Core.Window.vcxproj" "${TITAN_ROOT}")
  foreach(want "NativeCode/Base/Base.vcxitems" "NativeCode/NextRHI/NullDevice/NullDevice.vcxitems"
               "3rd/native/zstd/zstd.vcxitems")
    list(FIND imps "${want}" idx)
    if(idx EQUAL -1)
      message(FATAL_ERROR "test_read_imports: ${want} missing: ${imps}")
    endif()
  endforeach()
  if(imps MATCHES "codegen")
    message(FATAL_ERROR "test_read_imports: generated imports must be consumed after generation")
  endif()
  list(LENGTH imps n)
  if(n LESS 50)
    message(FATAL_ERROR "test_read_imports: expected >=50 shared imports, got ${n}")
  endif()
  message(STATUS "[titan-cmake-tests] PASS test_read_imports")
endfunction()


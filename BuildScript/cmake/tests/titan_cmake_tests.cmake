# 中间产物必须落在 intermediate/cpp/<Project>/<Config>，与 MSBuild 的 intermediate 惯例一致；
# 在源码目录内配置会把 CMakeCache/Ninja 日志/对象文件混进仓库树，必须直接拒绝。
function(test_build_dir_must_be_out_of_source)
  set(root "${TEST_TMP}/build-layout")
  set(src "${root}/Core.Android")
  file(MAKE_DIRECTORY "${src}")
  file(WRITE "${src}/CMakeLists.txt"
"cmake_minimum_required(VERSION 3.24)\n"
"project(BuildLayoutTest LANGUAGES NONE)\n"
"set(FAKE_ROOT \"${root}\")\n"
"include(\"${TITAN_ROOT}/BuildScript/cmake/TitanBuildLayout.cmake\")\n"
"titan_default_build_dir(default \"\${FAKE_ROOT}\" Core.Android Debug)\n"
"titan_require_out_of_source_build(\"\${CMAKE_CURRENT_LIST_DIR}\" \"\${FAKE_ROOT}\" Core.Android Debug)\n"
"file(WRITE \"\${CMAKE_BINARY_DIR}/build-dir.txt\" \"\${default}\")\n")
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${src}" -B "${src}/build"
    RESULT_VARIABLE rc OUTPUT_VARIABLE out ERROR_VARIABLE err)
  # 子进程输出受控制台代码页影响，中文不可稳定匹配；改用固定 ASCII 标记。
  if(rc EQUAL 0 OR NOT "${out}${err}" MATCHES "titan-build")
    message(FATAL_ERROR "test_build_dir_must_be_out_of_source: 源码内构建未被拒绝\n${out}${err}")
  endif()
  set(expected "${root}/intermediate/cpp/Core.Android/Debug")
  execute_process(COMMAND "${CMAKE_COMMAND}" -S "${src}" -B "${expected}"
    RESULT_VARIABLE rc2 OUTPUT_VARIABLE out2 ERROR_VARIABLE err2)
  if(NOT rc2 EQUAL 0)
    message(FATAL_ERROR "test_build_dir_must_be_out_of_source: 标准构建目录被拒绝\n${out2}${err2}")
  endif()
  file(READ "${expected}/build-dir.txt" actual)
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "titan_default_build_dir 路径不符: got ${actual} expected ${expected}")
  endif()
  # 每个走 CMake 的原生平台工程都必须启用该守卫，否则新平台会把中间产物写回源码目录。
  file(GLOB _platforms LIST_DIRECTORIES true RELATIVE "${TITAN_ROOT}" "${TITAN_ROOT}/Core.*")
  set(_checked 0)
  foreach(_platform IN LISTS _platforms)
    if(NOT IS_DIRECTORY "${TITAN_ROOT}/${_platform}" OR NOT EXISTS "${TITAN_ROOT}/${_platform}/CMakeLists.txt")
      continue()
    endif()
    file(READ "${TITAN_ROOT}/${_platform}/CMakeLists.txt" cml)
    if(NOT cml MATCHES "titan_require_out_of_source_build")
      message(FATAL_ERROR "${_platform}/CMakeLists.txt 未启用 titan_require_out_of_source_build")
    endif()
    math(EXPR _checked "${_checked}+1")
  endforeach()
  if(_checked LESS 2)
    message(FATAL_ERROR "test_build_dir_must_be_out_of_source: 至少应校验 2 个平台工程，实际 ${_checked}")
  endif()
  message(STATUS "[titan-cmake-tests] PASS test_build_dir_must_be_out_of_source")
endfunction()

# 两种源码工具都必须在运行生成之前完成自举，不允许编译引擎类型副本。
function(test_generate_codegen_bootstrap_order)
  # 自举与执行段已下沉到共享模块；Mac 入口只保留主机工具链查询。
  file(READ "${TITAN_ROOT}/BuildScript/cmake/TitanCodegenGen.cmake" gen)
  string(FIND "${gen}" "CppWeavingTools/CppWeavingTools.csproj" build_weaving)
  string(FIND "${gen}" "CppWeavingTools.dll" run_weaving)
  string(FIND "${gen}" "CSharpCodeTools/CSharpCodeTools.csproj" build_cstools)
  string(FIND "${gen}" "CSharpCodeTools.dll" run_cstools)
  if(build_weaving EQUAL -1 OR NOT build_weaving LESS run_weaving OR NOT build_cstools LESS run_weaving
     OR NOT build_cstools LESS run_cstools)
    message(FATAL_ERROR "test_generate_codegen_bootstrap_order: TitanCodegenGen.cmake must build both tools before generation")
  endif()
  file(READ "${TITAN_ROOT}/Core.Mac/GenerateCodegen.cmake" wrapper)
  if(NOT wrapper MATCHES "titan_run_platform_codegen" OR wrapper MATCHES "CppWeavingTools\\.csproj"
     OR NOT wrapper MATCHES "titan_platform_context\\\(Mac")
    message(FATAL_ERROR "test_generate_codegen_bootstrap_order: Mac entry must delegate to the shared runner")
  endif()
  # Windows 两阶段各自依赖轻量工具；源码阶段不由 native 的时间戳门禁跳过。
  file(READ "${TITAN_ROOT}/BuildScript/msbuild/TitanCodeGen.targets" tgt)
  if(NOT tgt MATCHES "DependsOnTargets=\"TitanGenerateNativeBindings;TitanGenerateManagedSources\""
     OR NOT tgt MATCHES "Name=\"TitanGenerateNativeBindings\"[^>]*DependsOnTargets=\"_EnsureCodeGenToolsBuilt;"
     OR NOT tgt MATCHES "Name=\"TitanGenerateManagedSources\"[^>]*DependsOnTargets=\"_EnsureCSharpCodeToolsBuilt\"")
    message(FATAL_ERROR "test_generate_codegen_bootstrap_order: Windows source stages must be split and bootstrap without engine/binder")
  endif()
  # CI 入口 build.ps1：主流程同样先构建两种轻量工具。
  file(READ "${TITAN_ROOT}/BuildScript/build.ps1" ps)
  string(REPLACE "\r" "" ps "${ps}")
  string(FIND "${ps}" "Invoke-DotNetBuild $cppWeavingProject" build_weaving)
  string(FIND "${ps}" "\n        Invoke-CppWeaving $config\n" run_weaving)
  string(FIND "${ps}" "Invoke-DotNetBuild $csharpCodeToolsProject" build_cstools)
  string(FIND "${ps}" "\n        Invoke-CSharpCodeTools $config\n" run_cstools)
  if(build_weaving EQUAL -1 OR NOT build_weaving LESS run_weaving OR NOT build_cstools LESS run_weaving
     OR NOT build_cstools LESS run_cstools)
    message(FATAL_ERROR "test_generate_codegen_bootstrap_order: build.ps1 must build both tools then generate selected configuration")
  endif()
  message(STATUS "[titan-cmake-tests] PASS test_generate_codegen_bootstrap_order")
endfunction()


<?xml version="1.0" encoding="utf-8"?>
<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <MSBuildAllProjects>$(MSBuildAllProjects);$(MSBuildThisFileFullPath)</MSBuildAllProjects>
    <HasSharedItems>true</HasSharedItems>
    <SharedGUID>3c1f6a52-8d1e-4b7a-9f0c-6b2e4d7a91c3</SharedGUID>
  </PropertyGroup>
  <PropertyGroup Label="Configuration">
    <Import_RootNamespace>Mac</Import_RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(MSBuildThisFileDirectory)..\Windows\FileManager.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\Windows\ClrProfiler.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)..\Windows\ExcelOperator.cs" />
    <Compile Include="$(MSBuildThisFileDirectory)PlatformMac.cs" />
  </ItemGroup>
</Project>

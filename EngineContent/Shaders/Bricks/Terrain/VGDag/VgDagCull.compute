#include "../../../Inc/GlobalDefine.cginc"

// 地形 cluster DAG 远景绘制: GPU cull + compact + indirect args
// Pass 1: CS_ClearDrawArgs - 清零 DrawIndexedInstancedIndirect 参数(InstanceCount=0)
// Pass 2: CS_CullClusters  - 每 cluster 一线程: 组一致 LOD 选择(VgDagLod.cginc) + frustum cull,
//                            可见 cluster 下标压缩写入 DrawClusters, InstanceCount atomicAdd
//
// 绘制端(VgDagDrawModifier.cginc): instance = DrawClusters[i], 每实例画
// VG_CLUSTER_MAX_INDEX 个顺序 index 的 dummy patch, VS 按 cluster 局部索引拉取顶点,
// 超出 cluster.IndexCount 的三角退化。
// uint buffer 在引擎里统一按 raw 创建(TtGpuBuffer<uint>), 这里用 (RW)ByteAddressBuffer。

cbuffer cbVgVisParams
{
    FVgVisParams VgVisParams;
};

StructuredBuffer<FVgVisCluster> VisClusterBuffer;
StructuredBuffer<FVgVisGroup>   VisGroupBuffer;

RWByteAddressBuffer DrawClusters;
RWByteAddressBuffer DrawArgs;

#include "VgDagLod.cginc"

[numthreads(1, 1, 1)]
void CS_ClearDrawArgs(uint tid : SV_DispatchThreadID)
{
    DrawArgs.Store(0, VG_CLUSTER_MAX_INDEX);   // IndexCountPerInstance
    DrawArgs.Store(4, 0);                      // InstanceCount(cull 端 atomicAdd)
    DrawArgs.Store(8, 0);                      // StartIndexLocation
    DrawArgs.Store(12, 0);                     // BaseVertexLocation
    DrawArgs.Store(16, 0);                     // StartInstanceLocation
}

// cluster AABB 对视锥的保守测试: 8 角在齐次 clip 空间对左右上下四个平面做 outcode,
// 全部落在同一平面外侧才剔除。齐次判定对 w <= 0 的角同样成立; 不测近/远平面(远景, 保守)。
bool ClusterVisible(FVgVisCluster c)
{
    float3 bmin = VgTexelBoxMin(c.MinTexelX, c.MinTexelZ, c.MinY);
    float3 bmax = VgTexelBoxMax(c.MaxTexelX, c.MaxTexelZ, c.MaxY);

    uint outAll = 0xF;
    [unroll]
    for (uint i = 0; i < 8; i++)
    {
        float3 p = float3((i & 1) ? bmax.x : bmin.x,
                          (i & 2) ? bmax.y : bmin.y,
                          (i & 4) ? bmax.z : bmin.z);
        float4 clip = mul(float4(p, 1), VgVisParams.ViewProj);
        uint code = 0;
        code |= (clip.x < -clip.w) ? 1u : 0u;
        code |= (clip.x >  clip.w) ? 2u : 0u;
        code |= (clip.y < -clip.w) ? 4u : 0u;
        code |= (clip.y >  clip.w) ? 8u : 0u;
        outAll &= code;
    }
    return outAll == 0;
}

[numthreads(64, 1, 1)]
void CS_CullClusters(uint tid : SV_DispatchThreadID)
{
    uint clusterCount = (uint)VgVisParams.Vis.y;
    if (tid >= clusterCount)
        return;

    FVgVisCluster c = VisClusterBuffer[tid];
    if (c.IndexCount == 0)
        return;

    if (VgClusterSelected(c) == false)
        return;

    if (ClusterVisible(c) == false)
        return;

    uint slot;
    DrawArgs.InterlockedAdd(4, 1, slot);
    DrawClusters.Store(slot * 4, tid);
}

#ifndef _HZB_H_
#define _HZB_H_
#include "../../Inc/GlobalDefine.cginc"

// HZB 存单通道 NDC-Z (raw device depth), 不做线性化.
// Inverse-Z 约定: NDC-Z=1 近平面, NDC-Z=0 远平面/天空.
// Downsample 用 min(): min(NDC-Z) = 最远表面 = conservative for occlusion.
// 优势: 省一半显存和带宽 (R32F 单通道 vs 旧方案 R16G16), 且避免了线性化的精度损失.

Texture2D<float> DepthBuffer;

// SrcBuffer 必须是 SRV (Texture2D), 不能与 DstBuffer 共用 RWTexture2D 通道.
// 历史 BUG: 两个 RWTexture2D binder 会被引擎绑到同一份默认 UAV 视图 → mip 链全断.
// 改成 SRV 后 SrcBuffer 落在 SBT_SRV 槽位, 与 SBT_UAV 物理隔离, 不再冲突.
Texture2D<float> SrcBuffer;
VK_IMAGE(r32f)
RWTexture2D<float> DstBuffer;

[numthreads(DispatchX, DispatchY, DispatchZ)]
void CS_Setup(uint3 id : SV_DispatchThreadID,
	uint3 GroupId : SV_GroupID,
	uint3 GroupThreadId : SV_GroupThreadID,
	uint GroupIndex : SV_GroupIndex)
{
	uint2 texSize;
	DstBuffer.GetDimensions(texSize.x, texSize.y);
	if (any(id.xy >= texSize))
		return;

    // mip0 = depth/2 (整除, 由 C# 端 OnResize 保证), 因此 id*2 + (1,1) 不会越界.
    // 直接存 raw NDC-Z, 不做线性化.
    float d1 = DepthBuffer[id.xy * 2].r;
    float d2 = DepthBuffer[id.xy * 2 + int2(0, 1)].r;
    float d3 = DepthBuffer[id.xy * 2 + int2(1, 0)].r;
    float d4 = DepthBuffer[id.xy * 2 + int2(1, 1)].r;

    // Inverse-Z: min(NDC-Z) = 最远表面 = conservative (不漏检)
    DstBuffer[id.xy] = min(min(d1, d2), min(d3, d4));
}

[numthreads(DispatchX, DispatchY, DispatchZ)]
void CS_DownSample(uint3 id : SV_DispatchThreadID,
	uint3 GroupId : SV_GroupID,
	uint3 GroupThreadId : SV_GroupThreadID,
	uint GroupIndex : SV_GroupIndex)
{
	uint2 texSize;
	DstBuffer.GetDimensions(texSize.x, texSize.y);
	if (any(id.xy >= texSize))
		return;

    float s1 = SrcBuffer[id.xy * 2];
    float s2 = SrcBuffer[id.xy * 2 + int2(0, 1)];
    float s3 = SrcBuffer[id.xy * 2 + int2(1, 0)];
    float s4 = SrcBuffer[id.xy * 2 + int2(1, 1)];

    DstBuffer[id.xy] = min(min(s1, s2), min(s3, s4));
}

#endif //#ifndef _HZB_H_
#ifndef _SSAO_FILTER_COMPUTE_H_
#define _SSAO_FILTER_COMPUTE_H_

#include "../../Inc/SysFunction.cginc"
#include "../../CBuffer/VarBase_PerCamera.cginc"

// ---------------------------------------------------------------------------
// SSAO Spatial Filter — edge-aware bilateral blur at half resolution.
//
// Runs after the SSAO compute pass. Uses depth to detect edges and preserve
// AO boundaries at geometry discontinuities. Currently a 3×3 cross-bilateral
// filter; can be extended to larger kernels or multi-pass separable blur.
//
// Reference: UE GTAO_SpatialFilter / Jimenez et al. 2016
// ---------------------------------------------------------------------------

cbuffer cbSSAOFilter DX_AUTOBIND
{
    float2 FilterScreenSize;   // Half-res dimensions
    float  FilterSharpness;    // Edge-aware sharpness (higher = preserve more edges)
};

Texture2D<float> SSAORawInput DX_AUTOBIND;
SamplerState Samp_SSAORawInput DX_AUTOBIND;

Texture2D<float> FilterDepthBuffer DX_AUTOBIND;
SamplerState Samp_FilterDepthBuffer DX_AUTOBIND;

RWTexture2D<float> SSAOFilteredOutput DX_AUTOBIND;

float DepthWeight(float centerDepth, float sampleDepth, float sharpness)
{
    float diff = abs(centerDepth - sampleDepth);
    return exp2(-diff * diff * sharpness);
}

[numthreads(8, 8, 1)]
void CS_SSAOFilter(uint3 dispatchThreadId : SV_DispatchThreadID)
{
    uint2 pixelCoord = dispatchThreadId.xy;
    if (pixelCoord.x >= (uint)FilterScreenSize.x || pixelCoord.y >= (uint)FilterScreenSize.y)
    {
        return;
    }

    float2 uv = ((float2)pixelCoord + 0.5) / FilterScreenSize;
    float2 texelSize = 1.0 / FilterScreenSize;

    // Sample center
    float centerAO = SSAORawInput.SampleLevel(Samp_SSAORawInput, uv, 0).r;
    float centerDepth = LinearFromDepth(FilterDepthBuffer.SampleLevel(Samp_FilterDepthBuffer, uv, 0).r);

    // 3×3 edge-aware bilateral min filter.
    // For each neighbor on the same surface (depth-similar), take min AO.
    // Neighbors across depth edges are ignored — preserves AO boundaries.
    // Conservative strategy: prefer more occlusion to avoid light leaking.
    float minAO = centerAO;

    static const float2 offsets[8] = {
        float2( 0, -1), float2( 0,  1), float2(-1,  0), float2( 1,  0),
        float2(-1, -1), float2( 1, -1), float2(-1,  1), float2( 1,  1)
    };

    [unroll]
    for (int i = 0; i < 8; i++)
    {
        float2 sampleUV = uv + offsets[i] * texelSize;
        float sampleAO = SSAORawInput.SampleLevel(Samp_SSAORawInput, sampleUV, 0).r;
        float sampleDepth = LinearFromDepth(FilterDepthBuffer.SampleLevel(Samp_FilterDepthBuffer, sampleUV, 0).r);

        // Only consider neighbors on the same surface
        float depthW = DepthWeight(centerDepth, sampleDepth, FilterSharpness);
        if (depthW > 0.5)
            minAO = min(minAO, sampleAO);
    }

    SSAOFilteredOutput[pixelCoord] = minAO;
}

#endif // _SSAO_FILTER_COMPUTE_H_

    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Link>
      <AdditionalLibraryDirectories>$(MSBuildThisFileDirectory)lib\windows\x64\Debug;%(AdditionalLibraryDirectories)</AdditionalLibraryDirectories>

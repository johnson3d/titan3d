<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../BuildScript/msbuild/TitanManagedProject.props" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <BaseOutputPath>$(TtTitanRoot)\binaries\Plugins</BaseOutputPath>
	<GenerateAssemblyInfo>false</GenerateAssemblyInfo>
	<GenerateTargetFrameworkAttribute>false</GenerateTargetFrameworkAttribute>
  </PropertyGroup>

  <Import Project="..\DataCopyer\DataCopyer.projitems" Label="Shared" />

  <!-- 反射阶段生成的平台 Copyer 与插件引用清单；不再按通配符引用 binaries/Plugins。 -->
  <PropertyGroup>
    <TitanDataCopyerGenerated>$([MSBuild]::NormalizePath('$(TitanCodeGenRoot)', 'DataCopyer', 'Copyer.gen.cs'))</TitanDataCopyerGenerated>
    <TitanDataCopyerReferences>$([MSBuild]::NormalizePath('$(TitanCodeGenRoot)', 'DataCopyer', 'Copyer.references'))</TitanDataCopyerReferences>
  </PropertyGroup>

  <ItemGroup>
	  <Compile Include="$(TitanDataCopyerGenerated)" />
	  <Reference Include="$(TitanEngineAssemblyName)">
		  <HintPath>$(TitanEngineAssemblyPath)</HintPath>
		  <Private>false</Private>
	  </Reference>
  </ItemGroup>

  <Target Name="TitanValidateDataCopyerGenerated" BeforeTargets="ResolveAssemblyReferences;CoreCompile">
    <Error Condition="!Exists('$(TitanDataCopyerGenerated)') OR !Exists('$(TitanDataCopyerReferences)')"
           Text="缺少反射阶段输出 $(TitanDataCopyerGenerated) 或 $(TitanDataCopyerReferences)；请先对 $(TitanEngineAssemblyName) 执行 TitanRunDataCopyerStage。" />
    <ReadLinesFromFile File="$(TitanDataCopyerReferences)">
      <Output TaskParameter="Lines" ItemName="_TitanDataCopyerPluginReference" />
    </ReadLinesFromFile>
    <ItemGroup>
      <Reference Include="@(_TitanDataCopyerPluginReference)" Private="false" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <!--<ProjectReference Include="..\..\..\Module\Engine.Window\Engine.Window.csproj">
		<Private>False</Private>
	</ProjectReference>-->
    <!--<ProjectReference Include="..\..\Game\Survivor\Survivor.All\Survivor.All.csproj">
		<Private>False</Private>
	</ProjectReference>-->
  </ItemGroup>

</Project>

<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../../BuildScript/msbuild/TitanManagedProject.props" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <BaseOutputPath>$(TtTitanRoot)binaries/Plugins</BaseOutputPath>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|AnyCPU'">
    <DefineConstants>$(DefineConstants);TitanEngine_AutoGen_Macross;TitanEngine_AutoGen_RPC</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|AnyCPU'">
    <DefineConstants>$(DefineConstants);TitanEngine_AutoGen_Macross;TitanEngine_AutoGen_RPC</DefineConstants>
  </PropertyGroup>

  <Import Project="..\Survivor.projitems" Label="Shared" />
  <Import Project="..\..\..\..\BuildScript\leanclr\LeanClrPlugin.targets" />

  <ItemGroup>
    <ProjectReference Include="$(TitanEngineProject)" />
    <ProjectReference Include="..\..\..\GameCore\Inventory\Inventory.All\Inventory.All.csproj" />
  </ItemGroup>

</Project>

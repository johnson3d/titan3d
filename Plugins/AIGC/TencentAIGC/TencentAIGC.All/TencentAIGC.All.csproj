<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../../BuildScript/msbuild/TitanManagedProject.props" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <BaseOutputPath>$(TtTitanRoot)binaries/Plugins</BaseOutputPath>
	<CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>

  <Import Project="..\TencentAIGC\TencentAIGC.projitems" Label="Shared" />

  <ItemGroup>
    <PackageReference Include="TencentCloudSDK" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="$(TitanEngineProject)" />
  </ItemGroup>

</Project>

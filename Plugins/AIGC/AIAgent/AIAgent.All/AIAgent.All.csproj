<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../../BuildScript/msbuild/TitanManagedProject.props" />

  <PropertyGroup>
    <TargetFramework>$(_TitanTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <BaseOutputPath>$(TtTitanRoot)binaries/Plugins</BaseOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <AllowUnsafeBlocks>True</AllowUnsafeBlocks>
  </PropertyGroup>

  <Import Project="..\AIAgent\AIAgent.projitems" Label="Shared" />

  <ItemGroup>
    <ProjectReference Include="$(TitanEngineProject)" />
  </ItemGroup>

</Project>
<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="../../../../BuildScript/msbuild/TitanManagedProject.props" />

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <BaseOutputPath>$(TtTitanRoot)binaries/Plugins</BaseOutputPath>
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
    <!-- RenderDoc 的 SetActiveWindow 收 void*, 抓帧工具绕不开 unsafe。 -->
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <Import Project="..\MCPServer\MCPServer.projitems" Label="Shared" />

  <ItemGroup>
    <ProjectReference Include="$(TitanEngineProject)" />
  </ItemGroup>

</Project>

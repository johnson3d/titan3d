<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <BaseOutputPath>$(SolutionDir)\binaries\Plugins</BaseOutputPath>
    <!-- 共享 RPC 调用方由生成清单校验后接入，不再导入旧生成工程。 -->
    <TitanConsumeRpcCallers>true</TitanConsumeRpcCallers>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\..\..\Module\Engine.Window\Engine.Window.csproj" />
  </ItemGroup>
  <Import Project="..\RpcCaller\RpcCaller.projitems" Label="Shared" />
</Project>
